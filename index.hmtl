```html
<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Corre - Controle Financeiro para Apps</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            ifood: '#EA1D2C',
                            lalamove: '#F26522',
                            app99: '#FFB800',
                            uber: '#000000',
                            outros: '#8B5CF6',
                            primary: '#10B981',
                            darkbg: '#0F172A',
                            cardbg: '#1E293B'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Custom scrollbars */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col pb-12 antialiased">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-30 bg-slate-800/90 backdrop-blur-md border-b border-slate-700 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Title -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-slate-900 font-extrabold text-xl shadow-md">
                        <i class="fa-solid fa-motorcycle"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg leading-tight tracking-wide text-white">Meu Corre <span class="text-xs font-normal text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 px-2 py-0.5 rounded-full">v2.0</span></h1>
                        <p class="text-xs text-slate-400 hidden sm:block">Controle financeiro para motoristas e entregadores</p>
                    </div>
                </div>

                <!-- Action Controls -->
                <div class="flex items-center gap-2">
                    <button id="btnBackupModal" class="flex items-center gap-2 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs sm:text-sm font-medium px-3 py-2 rounded-lg transition-all border border-slate-600">
                        <i class="fa-solid fa-database text-emerald-400"></i>
                        <span class="hidden sm:inline">Dados / Backup</span>
                    </button>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="flex space-x-2 border-t border-slate-700/60 pt-2 pb-2">
                <button id="tabBtnLancar" onclick="switchTab('lancar')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 py-2 px-4 rounded-lg text-sm font-semibold transition-all bg-emerald-500 text-slate-950 shadow-md">
                    <i class="fa-solid fa-plus-circle"></i>
                    <span>Lançar Ganhos</span>
                </button>
                <button id="tabBtnResumo" onclick="switchTab('resumo')" class="flex-1 sm:flex-none flex items-center justify-center gap-2 py-2 px-4 rounded-lg text-sm font-semibold transition-all text-slate-400 hover:text-slate-100 hover:bg-slate-700/50">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Resumo & Relatórios</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 flex-grow w-full">

        <!-- TAB 1: LANÇAR GANHOS -->
        <section id="tabLancar" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Form Card -->
                <div class="lg:col-span-5 bg-slate-800 rounded-2xl p-5 sm:p-6 border border-slate-700 shadow-xl self-start">
                    <div class="flex items-center justify-between mb-5">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-receipt text-emerald-400"></i>
                            Novo Lançamento
                        </h2>
                        <span class="text-xs text-slate-400">Preencha os dados da jornada</span>
                    </div>

                    <form id="earningsForm" onsubmit="handleSaveEntry(event)" class="space-y-4">
                        <!-- App Selection -->
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-2">Aplicativo / Serviço *</label>
                            <div class="grid grid-cols-3 sm:grid-cols-5 gap-2" id="appSelectGrid">
                                <button type="button" onclick="selectApp('ifood')" id="appBtn-ifood" class="app-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-700 bg-slate-900/60 hover:bg-slate-700 text-slate-300 transition-all">
                                    <span class="w-3 h-3 rounded-full bg-red-600 mb-1"></span>
                                    <span class="text-xs font-semibold">iFood</span>
                                </button>
                                <button type="button" onclick="selectApp('lalamove')" id="appBtn-lalamove" class="app-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-700 bg-slate-900/60 hover:bg-slate-700 text-slate-300 transition-all">
                                    <span class="w-3 h-3 rounded-full bg-orange-500 mb-1"></span>
                                    <span class="text-xs font-semibold">Lalamove</span>
                                </button>
                                <button type="button" onclick="selectApp('99')" id="appBtn-99" class="app-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-700 bg-slate-900/60 hover:bg-slate-700 text-slate-300 transition-all">
                                    <span class="w-3 h-3 rounded-full bg-amber-400 mb-1"></span>
                                    <span class="text-xs font-semibold">99</span>
                                </button>
                                <button type="button" onclick="selectApp('uber')" id="appBtn-uber" class="app-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-700 bg-slate-900/60 hover:bg-slate-700 text-slate-300 transition-all">
                                    <span class="w-3 h-3 rounded-full bg-slate-100 mb-1"></span>
                                    <span class="text-xs font-semibold">Uber</span>
                                </button>
                                <button type="button" onclick="selectApp('outros')" id="appBtn-outros" class="app-btn flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-700 bg-slate-900/60 hover:bg-slate-700 text-slate-300 transition-all">
                                    <span class="w-3 h-3 rounded-full bg-purple-500 mb-1"></span>
                                    <span class="text-xs font-semibold">Outros</span>
                                </button>
                            </div>
                            <input type="hidden" id="selectedApp" value="ifood" required>
                        </div>

                        <!-- Custom App Name (if 'outros') -->
                        <div id="customAppContainer" class="hidden">
                            <label class="block text-xs font-medium text-slate-300 mb-1">Nome do Serviço Personalizado</label>
                            <input type="text" id="customAppName" placeholder="Ex: Borzo, Loggi, Particular..." class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                        </div>

                        <!-- Date & Value -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Data *</label>
                                <input type="date" id="entryDate" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Valor Bruto (R$) *</label>
                                <div class="relative">
                                    <span class="absolute left-3 top-2.5 text-slate-400 font-semibold text-sm">R$</span>
                                    <input type="number" step="0.01" min="0.01" id="entryAmount" placeholder="0,00" required class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-9 pr-3 py-2 text-sm text-white font-semibold focus:outline-none focus:border-emerald-500">
                                </div>
                            </div>
                        </div>

                        <!-- Work Shift Hours -->
                        <div class="p-3 bg-slate-900/60 border border-slate-700/60 rounded-xl space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-slate-300"><i class="fa-regular fa-clock text-emerald-400 mr-1"></i> Horário da Jornada</span>
                                <span id="calculatedHoursText" class="text-xs text-emerald-400 font-medium">0.0 hrs</span>
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] text-slate-400 mb-1">Hora Início</label>
                                    <input type="time" id="startTime" onchange="updateCalculatedHours()" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                                </div>
                                <div>
                                    <label class="block text-[11px] text-slate-400 mb-1">Hora Término</label>
                                    <input type="time" id="endTime" onchange="updateCalculatedHours()" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                                </div>
                            </div>
                        </div>

                        <!-- KM & Notes -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">KM Rodados (opcional)</label>
                                <div class="relative">
                                    <input type="number" step="0.1" min="0" id="entryKm" placeholder="Ex: 85" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                                    <span class="absolute right-3 top-2.5 text-xs text-slate-400">km</span>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Observação (opcional)</label>
                                <input type="text" id="entryNotes" placeholder="Ex: Chuva, bônus..." class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="w-full bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold py-3 px-4 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 text-sm mt-2">
                            <i class="fa-solid fa-floppy-disk"></i>
                            <span>Salvar Lançamento</span>
                        </button>
                    </form>
                </div>

                <!-- Recent Entries List Card -->
                <div class="lg:col-span-7 bg-slate-800 rounded-2xl p-5 sm:p-6 border border-slate-700 shadow-xl flex flex-col">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                        <div>
                            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-history text-emerald-400"></i>
                                Histórico Recente
                            </h2>
                            <p class="text-xs text-slate-400">Últimos lançamentos cadastrados</p>
                        </div>
                        <div class="relative w-full sm:w-48">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-slate-400"></i>
                            <input type="text" id="searchHistory" oninput="renderRecentEntries()" placeholder="Buscar app ou nota..." class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-8 pr-3 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>

                    <div class="overflow-x-auto flex-grow">
                        <div id="recentEntriesList" class="space-y-2">
                            <!-- Dynamic Content Rendered Here -->
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- TAB 2: RESUMO & RELATÓRIOS -->
        <section id="tabResumo" class="hidden space-y-6">

            <!-- KPI Cards Grid -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <!-- Hoje -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 shadow-lg flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase">
                        <span>Total Hoje</span>
                        <div class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                            <i class="fa-solid fa-calendar-day"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div id="kpiToday" class="text-xl sm:text-2xl font-extrabold text-white">R$ 0,00</div>
                        <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-400">
                            <span id="kpiTodayHours"><i class="fa-regular fa-clock mr-1"></i>0h</span>
                            <span>•</span>
                            <span id="kpiTodayRate" class="text-emerald-400 font-medium">R$ 0,00/h</span>
                        </div>
                    </div>
                </div>

                <!-- Semana -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 shadow-lg flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase">
                        <span>Esta Semana</span>
                        <div class="w-7 h-7 rounded-lg bg-teal-500/10 text-teal-400 flex items-center justify-center">
                            <i class="fa-solid fa-calendar-week"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div id="kpiWeek" class="text-xl sm:text-2xl font-extrabold text-white">R$ 0,00</div>
                        <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-400">
                            <span id="kpiWeekHours"><i class="fa-regular fa-clock mr-1"></i>0h</span>
                            <span>•</span>
                            <span id="kpiWeekRate" class="text-teal-400 font-medium">R$ 0,00/h</span>
                        </div>
                    </div>
                </div>

                <!-- Mês -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 shadow-lg flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase">
                        <span>Este Mês</span>
                        <div class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div id="kpiMonth" class="text-xl sm:text-2xl font-extrabold text-white">R$ 0,00</div>
                        <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-400">
                            <span id="kpiMonthHours"><i class="fa-regular fa-clock mr-1"></i>0h</span>
                            <span>•</span>
                            <span id="kpiMonthRate" class="text-cyan-400 font-medium">R$ 0,00/h</span>
                        </div>
                    </div>
                </div>

                <!-- Ano -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 shadow-lg flex flex-col justify-between">
                    <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase">
                        <span>Este Ano</span>
                        <div class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center">
                            <i class="fa-solid fa-calendar text-purple-400"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div id="kpiYear" class="text-xl sm:text-2xl font-extrabold text-white">R$ 0,00</div>
                        <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-400">
                            <span id="kpiYearHours"><i class="fa-regular fa-clock mr-1"></i>0h</span>
                            <span>•</span>
                            <span id="kpiYearRate" class="text-purple-400 font-medium">R$ 0,00/h</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Report Filter Controls -->
            <div class="bg-slate-8
